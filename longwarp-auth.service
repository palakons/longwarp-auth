[Unit]
Description=Longwarp Central Auth Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/longwarp-auth
ExecStart=/usr/bin/node /var/www/longwarp-auth/dist/server.js
Restart=always
RestartSec=10
EnvironmentFile=/var/www/longwarp-auth/.env

[Install]
WantedBy=multi-user.target
