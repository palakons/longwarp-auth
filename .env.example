# ==============================================================================
# longwarp-auth Environment Configuration
# ==============================================================================

# Server Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# PostgreSQL Connection String
# Note: For Prisma / Node.js, use standard postgresql:// (not postgresql+psycopg://)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://auth_user:secure_password@127.0.0.1:5432/longwarp_db

# Google OAuth 2.0 Credentials
# Obtain from: https://console.cloud.google.com/apis/credentials
# Ensure Authorized Redirect URI includes: https://auth.longwarp.com/auth/google/callback (prod)
# and http://localhost:4000/auth/google/callback (local dev)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# JWT & Session Cookie Security
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
# In production set to .longwarp.com so cookie is shared with all subdomains.
# For local development without custom domains, leave empty or set to localhost.
COOKIE_DOMAIN=
# Comma-separated list of origins allowed to make credentialed requests
ALLOWED_ORIGINS=http://127.0.0.1:3002,http://localhost:3002,http://localhost:4000,http://localhost:3000,https://shabu.longwarp.com,https://toll.longwarp.com,https://trade.longwarp.com
